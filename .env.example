# PollyMarketAgent — environment example
# Copy to .env.local for local overrides (Vite: VITE_* only is exposed to client)

# Paper mode is default and fully client-side. Live signing is server-side only.
# NEVER put private keys in VITE_* variables (they ship to the browser).

# Optional display / branding
VITE_APP_NAME=PollyMarketAgent
VITE_DOMAIN=pollymarketagent.store

# Live mode (server / Netlify Functions only — NOT bundled into client):
# AGENT_PRIVATE_KEY=0x...   # EVM agent hot wallet
# SOLANA_AGENT_PRIVATE_KEY=  # base58 Solana agent key
# LIVE_TRADING_ENABLED=false

# Public API bases (defaults work without override)
VITE_DEXSCREENER_API=https://api.dexscreener.com
VITE_JUPITER_PRICE_API=https://api.jup.ag/price/v2
VITE_GAMMA_API=https://gamma-api.polymarket.com
VITE_CLOB_API=https://clob.polymarket.com
